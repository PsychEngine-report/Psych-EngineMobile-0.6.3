<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="FNF: PE 6.3" file="PsychEngine" packageName="com.shadowmario.psychengine063" package="com.shadowmario.psychengine063" main="Main" version="0.2.8" company="ShadowMario" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" require-shaders="true" />

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />
	
	<!-- PSYCH ENGINE CUSTOMIZATION -->
	<define name="MODS_ALLOWED" if="mobile" />
	<define name="LUA_ALLOWED" if="mobile" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="VIDEOS_ALLOWED" unless="32bits"/>
	<define name="PSYCH_WATERMARKS"/> <!-- DELETE THIS TO REMOVE WATERMARKS/DEV NAMES ON TITLE SCREEN -->
	<define name="TITLE_SCREEN_EASTER_EGG" if="officialBuild"/> <!-- DELETE THE if="officialBuild" for enabling this on an unofficial build -->
	<define name="DISCORD_ALLOWED" if="desktop" />

	<haxedef name="USING_GPU_TEXTURES" if="mobile" />

    <section if="USING_GPU_TEXTURES">
        <assets path="assets/preload/images-astc" rename="assets/images" />
        <assets path="assets/preload" rename="assets" exclude="*.mp3|images-png|images-astc" />

		<assets path="assets/shared/images-astc" rename="assets/images" />
        <assets path="assets/shared" rename="assets/shared" library="shared"  exclude="*.mp3|images-png|images-astc" unless="web" />
        
        <assets path="assets/exclude/images-astc" rename="assets/images" />
        <assets path="assets/exclude" rename="assets" exclude="*.mp3|images-png|images-astc" />
        
        <section if="TITLE_SCREEN_EASTER_EGG">
            <assets path="assets/secrets/images-astc" rename="assets/images" />
            <assets path="assets/secrets" rename="assets" exclude="*.mp3|images-png|images-astc" />
        </section>
    </section>

    <section unless="USING_GPU_TEXTURES">
        <assets path="assets/preload/images-png" rename="assets/images" />
        <assets path="assets/preload" rename="assets" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/preload" rename="assets" exclude="*.ogg|images-png|images-astc" if="web" />

		<assets path="assets/shared/images-png" rename="assets/images" />
        <assets path="assets/shared" rename="assets/shared" library="shared"  exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/shared" rename="assets/shared" library="shared"  exclude="*.ogg|images-png|images-astc" if="web" />
        
        <assets path="assets/exclude/images-png" rename="assets/images" />
        <assets path="assets/exclude" rename="assets" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/exclude" rename="assets" exclude="*.ogg|images-png|images-astc" if="web" />
        
        <section if="TITLE_SCREEN_EASTER_EGG">
            <assets path="assets/secrets/images-png" rename="assets/images" />
            <assets path="assets/secrets" rename="assets" exclude="*.mp3|images-png|images-astc" unless="web" />
            <assets path="assets/secrets" rename="assets" exclude="*.ogg|images-png|images-astc" if="web" />
        </section>
    </section>

    <section if="USING_GPU_TEXTURES">
    <assets path="assets/preload/mobile/images-astc" rename="assets/mobile/images" exclude="*.ogg|images-png|images-astc" if="web" library="mobile"/>
    <assets path="assets/preload/mobile" rename="assets/mobile" exclude="*.mp3|images-png|images-astc" unless="web" library="mobile"/>
</section>

<section unless="USING_GPU_TEXTURES">
    <assets path="assets/preload/mobile/images-png" rename="assets/mobile/images" exclude="*.ogg|images-png|images-astc" if="web" library="mobile"/>
    <assets path="assets/preload/mobile" rename="assets/mobile" exclude="*.mp3|images-png|images-astc" unless="web" library="mobile"/>
</section>

	<!-- DISABLED DUE OUTDATED -->
	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild"/>

	<!-- <define name="PRELOAD_ALL" /> -->
	<define name="PRELOAD_ALL" unless="web" />
	<define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>
	
	<library name="videos"        preload="true" />
	<section if="PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="true" />
		<library name="week2"         preload="true" />
		<library name="week3"         preload="true" />
		<library name="week4"         preload="true" />
		<library name="week5"         preload="true" />
		<library name="week6"         preload="true" />
		<library name="week7"         preload="true" />
	</section>
	
	<section if="NO_PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="false" />
		<library name="week2"         preload="false" />
		<library name="week3"         preload="false" />
		<library name="week4"         preload="false" />
		<library name="week5"         preload="false" />
		<library name="week6"         preload="false" />
		<library name="week7"         preload="false" />
	</section>
	
	<assets path="assets/videos"        library="videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         library="songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         library="songs"         exclude="*.mp3" unless="web"/>

	<section if="mobile">
        <assets path="assets/shared/images-astc" rename="assets/shared/images" library="shared" />
        <assets path="assets/shared" library="shared" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week2/images-astc" rename="assets/week2/images" library="week2" />
        <assets path="assets/week2" library="week2" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week3/images-astc" rename="assets/week3/images" library="week3" />
        <assets path="assets/week3" library="week3" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week4/images-astc" rename="assets/week4/images" library="week4" />
        <assets path="assets/week4" library="week4" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week5/images-astc" rename="assets/week5/images" library="week5" />
        <assets path="assets/week5" library="week5" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week6/images-astc" rename="assets/week6/images" library="week6" />
        <assets path="assets/week6" library="week6" exclude="*.mp3|images-png|images-astc" />

        <assets path="assets/week7/images-astc" rename="assets/week7/images" library="week7" />
        <assets path="assets/week7" library="week7" exclude="*.mp3|images-png|images-astc" />
    </section>

    <section unless="mobile">
        <assets path="assets/shared/images-png" rename="assets/shared/images" library="shared" />
        <assets path="assets/shared" library="shared" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/shared" library="shared" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week2/images-png" rename="assets/week2/images" library="week2" />
        <assets path="assets/week2" library="week2" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week2" library="week2" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week3/images-png" rename="assets/week3/images" library="week3" />
        <assets path="assets/week3" library="week3" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week3" library="week3" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week4/images-png" rename="assets/week4/images" library="week4" />
        <assets path="assets/week4" library="week4" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week4" library="week4" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week5/images-png" rename="assets/week5/images" library="week5" />
        <assets path="assets/week5" library="week5" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week5" library="week5" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week6/images-png" rename="assets/week6/images" library="week6" />
        <assets path="assets/week6" library="week6" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week6" library="week6" exclude="*.ogg|images-png|images-astc" if="web" />

        <assets path="assets/week7/images-png" rename="assets/week7/images" library="week7" />
        <assets path="assets/week7" library="week7" exclude="*.mp3|images-png|images-astc" unless="web" />
        <assets path="assets/week7" library="week7" exclude="*.ogg|images-png|images-astc" if="web" />
    </section>
	
	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false'/>
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' unless="mobile" />
	<!-- <template path='mods' /> -->
	
	<!-- assets path="CHANGELOG.md" rename='changelog.txt' -->

	<!-- NOTE FOR FUTURE SELF SINCE FONTS ARE ALWAYS FUCKY 
		TO FIX ONE OF THEM, I CONVERTED IT TO OTF. DUNNO IF YOU NEED TO
		THEN UHHH I USED THE NAME OF THE FONT WITH SETFORMAT() ON THE TEXT!!!
		NOT USING A DIRECT THING TO THE ASSET!!!
	-->
	<assets path="assets/fonts" embed='true'/>
	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxedev set='webgl' />

	<!--In case you want to use the addons package-->
	<haxelib name="flixel-addons" />
	<haxelib name="hscript" />
	<define name="hscriptPos" />

	<!--In case you want to use the ui package-->
	<haxelib name="flixel-ui" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED"/>
	<haxelib name="faxe" if='switch'/>
	<!--<haxelib name="polymod"/> -->
	<haxelib name="discord_rpc" if="DISCORD_ALLOWED"/>
	<!-- <haxelib name="hxcpp-debug-server" if="desktop"/> -->

	<!-- <haxelib name="markdown" /> -->
	<!-- <haxelib name="HtmlParser" /> -->

	<!--In case you want to use nape with flixel-->
	<!--<haxelib name="nape-haxe4" />-->

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef name="FLX_NO_GAMEPAD" />-->

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!--Allow working memory greater than 1 Gig-->
	<!--haxedef name="HXCPP_GC_BIG_BLOCKS"-->
	
	<!-- Show debug traces for hxCodec -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />
	
	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!--Used for crash handler-->
	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>
	
	<!-- Do whatever you want I'm tired uninstall and install everytime -->
	<certificate path="key.keystore" password="psychengine" alias="psychport" alias-password="psychengine" if="android" unless="debug" />

	<!-- Category Type for Apple Systems -->
	<config:ios category_type="public.app-category.music-games" />
	<config:mac category_type="public.app-category.music-games" />

	<!--Disable deprecated warnings-->
	<haxedef name='no-deprecation-warnings' />

	<!--Avoid memory leaks with for loops in HScript-->
	<haxedef name="loop_unroll_max_cost" value="25" />
	<haxedef name="DISABLED_MACRO_SUPERLATIVE" if="android" />

	<!--Macro fixes-->
	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />

	<haxedef name="SHARE_MOBILE_FILES" if="mobile" />

	<!-- _________________________________ Custom _______________________________ -->

	<!--Place custom nodes like icons here (higher priority to override the HaxeFlixel icon)-->
	
	<icon path="art/icon16.png" size='16'/>
	<icon path="art/icon32.png" size='32'/>
	<icon path="art/icon64.png" size='64'/>
	<icon path="art/iconOG.png" />
</project>
